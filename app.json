{
  "expo": {
    "entryPoint": "./src/index.js",
    "name": "Shop Shop",
    "slug": "beast",
    "scheme": "beast",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.68",
    "primaryColor": "#457AFF",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#457AFF"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.firedevs.beast",
      "buildNumber": "1.0.68",
      "config": {
        "usesNonExemptEncryption": false,
        "googleMapsApiKey": "AIzaSyD1Gd5wIw-a6ELjxPlMMgGj1x_FKWWF61c"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app usa la cámara para tomar imágenes de tiendas y productos",
        "NSPhotoLibraryUsageDescription": "Esta app usa la biblioteca de fotos para cargar imágenes de tiendas y productos"
      },
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.firedevs.beast",
      "icon": "./assets/icon-android.png",
      "versionCode": 390010068,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD1Gd5wIw-a6ELjxPlMMgGj1x_FKWWF61c"
        }
      }
    },
    "hooks": {
      "postPublish": [
        {
          "file": "sentry-expo/upload-sourcemaps",
          "config": {}
        }
      ]
    }
  }
}
