{
  "expo": {
    "entryPoint": "./src/index.js",
    "name": "beast-app",
    "slug": "beast-app",
    "scheme": "beast.app",
    "platforms": ["ios", "android", "web"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#457AFF"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.firedevs.beast",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.firedevs.beast",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "facebookScheme": "fb587498002202284"
  }
}
